# Supabase panelinden: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SIPARIS_MAKBUZ_SECRET=

# Bu dosyanin adini .env.local yapip degerleri doldur.
# SUPABASE_SERVICE_ROLE_KEY ve SIPARIS_MAKBUZ_SECRET asla git'e gonderilmemeli.
# Production siparis mutation'i yalniz Vercel'in otomatik VERCEL=1 ortami ve
# platformun x-vercel-forwarded-for basligi dogrulanirsa calisir.
# Local/dev tum istemci basliklarini yok sayar ve paylasilan gelistirme kovasi kullanir.
